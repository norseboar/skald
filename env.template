# Copy this file to .env.local and fill in your actual values
# For Vercel deployment, add these as environment variables in the Vercel dashboard

# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required scopes: repo (for private repos) or public_repo (for public repos only)
GITHUB_TOKEN=your_github_personal_access_token_here

# Comma-separated list of allowed repositories (format: owner/repo)
# Example: owner1/repo1,owner2/repo2,myusername/myrepo
ALLOWED_REPOS=your-username/your-repo

# API key for protecting endpoints (hardcoded, can be rotated)
# Use a strong random string. You can generate one with: openssl rand -hex 32
API_KEY=your_api_key_here

# Test repository for GitHub API integration tests (optional)
# Only needed if running: npm run test:github
# Should be a dedicated test repository that you don't mind having test files created/deleted in
TEST_REPO=your-username/test-repo



